# Porta HTTP do servidor
PORT=3000
# Caminho do banco SQLite
OUTFOOD_DB=./data/outfood.db
# Segredo usado para assinar os cookies de sessão (troque em produção)
OUTFOOD_SECRET=troque-este-segredo-em-producao
# Origem permitida para CORS (use * apenas em desenvolvimento)
OUTFOOD_ORIGIN=
# Usuário administrador criado no primeiro boot
OUTFOOD_ADMIN_EMAIL=admin@outfood.local
OUTFOOD_ADMIN_PASSWORD=outfood123
